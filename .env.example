# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=alcabots
ALCA_BIND_ADDRESS=127.0.0.1
ALCA_HTTP_PORT=8080
# Leave empty to use http://localhost:${ALCA_HTTP_PORT:-8080}.
ALCA_PUBLIC_URL=
# Leave empty to inherit ALCA_PUBLIC_URL.
ALCA_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set ALCA_PUBLIC_URL to https:// followed by the same hostname.
# Requires ALCA_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
ALCA_HTTPS_HOST=
ALCA_BASE_IMAGE=ghcr.io/ihsieh31/alca-bots:latest
ALCA_LOCAL_IMAGE=alcabots-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
ALCA_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
ALCA_DATA_EXTERNAL=false
