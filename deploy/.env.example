# Public hostname for automatic HTTPS (must resolve to this machine).
# Pairing links (`docker compose exec alca node dist-server/pair-cli.js`) point here.
DOMAIN=alca.example.com

# Engine CLIs baked into the image at build time (space-separated npm packages).
# Sign in afterwards with:  docker compose exec alca claude   (etc.)
ENGINES=@anthropic-ai/claude-code

# Optional: let people sign in with an emailed code instead of a pairing
# code. Addresses or @domain entries, comma-separated. Admins get full
# access; members get chat and approvals only.
ALCA_SIGNIN_EMAILS=
ALCA_SIGNIN_MEMBER_EMAILS=

# Optional: send those codes through your own mail server instead of the
# AlcaBots account service, e.g. smtps://user%40example.com:PASSWORD@smtp.example.com:465
# (docs/self-hosting.md). FROM defaults to the user name when it is an address.
ALCA_SIGNIN_SMTP_URL=
ALCA_SIGNIN_SMTP_FROM=
