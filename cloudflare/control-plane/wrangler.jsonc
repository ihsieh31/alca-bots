{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alcabots-control-plane",
  "main": "src/index.ts",
  "account_id": "c8670c9c7767c29df14ff4990dd62234",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "bots-accounts.alca-corp.me",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://bots-accounts.alca-corp.me",
    "EMAIL_FROM": "noreply@alca-corp.me",
    "ALLOWED_ORIGINS": "",
    "CLOUDFLARE_ACCOUNT_ID": "c8670c9c7767c29df14ff4990dd62234",
    "CLOUDFLARE_ZONE_ID": "9596447b63ad73b75761e0e183ba2cb5",
    "COMPANION_HOST_SUFFIX": "alca-corp.me",
    // Managed endpoint capacity of the account above (see README "Tunnel
    // capacity and idle reclaim"): keep them equal to Cloudflare's real quotas.
    // alca-corp.me is a Free zone: 200 DNS records.
    "ALCA_TUNNEL_LIMIT": "1000",
    "ALCA_DNS_RECORD_LIMIT": "200",
    // "on" marks idle tunnels for cleanup; "observe" only logs candidates.
    "ALCA_TUNNEL_RECLAIM": "on",
    "ALCA_TUNNEL_OFFLINE_RECLAIM_DAYS": "3",
    // Cleanup rows per five-minute cron run: 4 on Workers Free (50 subrequests
    // per invocation), 20 on Workers Paid.
    "ALCA_CLEANUP_SWEEP_LIMIT": "4",
    // AlcaBot Relay (README "AlcaBot Relay"): no relay node is deployed, so
    // every relay token is off. To enable, deploy relay/ on a server, list it
    // in RELAY_NODES, set RELAY_TOKEN_SIGNING_KEY and RELAY_DISABLED "0".
    "RELAY_NODES": "",
    "RELAY_NODES_AMERICAS": "",
    "RELAY_TOKEN_KID": "k1",
    "RELAY_ROLLOUT_PERCENT": "0",
    "RELAY_ALLOW_INSTALLATIONS": "",
    "RELAY_DISABLED": "1",
    "RELAY_CAPABLE_MIN_VERSION": ""
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "CLOUDFLARE_API_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alcabots-control-plane",
      "database_id": "975a4edd-0773-4978-8788-4daece91f791",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@alca-corp.me"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
